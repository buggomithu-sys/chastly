# ============================================
# Becastly - REQUIRED Configuration
# ============================================

# Database (PostgreSQL) - Auto-configured if using Docker
POSTGRES_USER=becastly
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=becastly

# Application Security - Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_32_character_encryption_key_here

# App URL - Your domain or IP
APP_URL=http://localhost

# ============================================
# OPTIONAL: Channel Integration Credentials
# These can be added later through the UI!
# Users can sign up and use the app without these.
# Add them only when you want to send actual messages.
# ============================================

# WhatsApp (Meta Business API) - Optional
META_WEBHOOK_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=

# SMS (Twilio) - Optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telegram Bot - Optional
TELEGRAM_BOT_TOKEN=

# Email (SMTP) - Optional
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ============================================
# NOTES:
# ============================================
# 1. Only the REQUIRED section above is needed to start the app
# 2. Users can register, login, and explore the app without any integrations
# 3. Add integrations later through Settings > Integrations page
# 4. Each integration has a "Test" button to verify it works
# 5. Start with one channel (e.g., Email via SMTP) and add more later
