# ==========================================
# Becastly Environment Configuration
# ==========================================

# ------------------------------------------
# Required Settings (Database & Security)
# ------------------------------------------

# PostgreSQL Database Configuration
POSTGRES_USER=becastly
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=becastly

# Encryption Key (Generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_32_char_hex_encryption_key_here

# Application URL (Your server IP or domain)
APP_URL=http://your-server-ip-or-domain

# Frontend API URL (for browser requests) - NO /api suffix
NEXT_PUBLIC_API_URL=http://your-server-ip-or-domain

# ------------------------------------------
# Optional Settings (Can be configured via UI later)
# ------------------------------------------

# Redis Configuration (default works for Docker setup)
REDIS_URL=redis://redis:6379

# Email Configuration (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Becastly

# Meta/WhatsApp Business API Configuration
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_TOKEN=

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=

# Node Environment (production/development)
NODE_ENV=production

# ------------------------------------------
# AI & Advanced Features
# ------------------------------------------

# OpenAI Configuration (for AI features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Twilio Voice API (for AI calling)
TWILIO_VOICE_API_KEY=
TWILIO_VOICE_APP_SID=

# Payment Gateways
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Advanced SMS Providers (optional)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
FAST2SMS_API_KEY=
AWS_SNS_ACCESS_KEY=
AWS_SNS_SECRET_KEY=
AWS_SNS_REGION=

# Evolution API (QR-based WhatsApp)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Anti-Spam & Reputation
ENABLE_AI_PARAPHRASING=true
ENABLE_WARMUP_MODE=true
DEFAULT_REPUTATION_THRESHOLD=70

# White-Label Domain
WHITE_LABEL_DOMAIN=

# Analytics & Tracking
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=
